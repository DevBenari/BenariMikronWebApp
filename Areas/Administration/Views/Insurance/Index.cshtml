<script>
    // Inisialisasi kanvas tanda tangan
    const canvases = document.querySelectorAll(".signatureCanvas");
    const dataFields = document.querySelectorAll(".signatureData");

    // Fungsi untuk memulai menggambar di kanvas tertentu
    canvases.forEach((canvas, index) => {
        const ctx = canvas.getContext("2d");
        let drawing = false;

        canvas.addEventListener("mousedown", () => drawing = true);
        canvas.addEventListener("mouseup", () => {
            drawing = false;
            ctx.beginPath();
        });
        canvas.addEventListener("mousemove", (event) => draw(event, canvas, ctx, drawing));
    });

    // Fungsi menggambar
    function draw(event, canvas, ctx, drawing) {
        if (!drawing) return;

        ctx.lineWidth = 2;
        ctx.lineCap = "round";
        ctx.strokeStyle = "black";

        ctx.lineTo(event.offsetX, event.offsetY);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(event.offsetX, event.offsetY);
    }

    // Fungsi untuk menghapus kanvas
    function clearCanvas(index) {
        const ctx = canvases[index].getContext("2d");
        ctx.clearRect(0, 0, canvases[index].width, canvases[index].height);
    }

    // Fungsi untuk menyimpan tanda tangan
    function saveSignature(index) {
        const dataURL = canvases[index].toDataURL("image/png");
        console.log(`Tanda tangan form ${index + 1} telah disimpan!`);
        console.log("Data URL:", dataURL); // Bisa dikirim ke server
        alert(`Tanda tangan form ${index + 1} telah disimpan!`);
    }

    // Fungsi untuk preview gambar cap
    function previewCap() {
        const fileInput = document.getElementById("uploadCap");
        const capPreview = document.getElementById("capPreview");

        const file = fileInput.files[0];
        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                capPreview.src = e.target.result; // Set gambar ke hasil upload
                capPreview.style.display = "block"; // Tampilkan gambar
            };

            reader.readAsDataURL(file); // Membaca file sebagai data URL
        }
    }

    // Fungsi submit form
    document.getElementById("signatureForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const capPreview = document.getElementById("capPreview");
        if (!capPreview.src || capPreview.style.display === "none") {
            alert("Silakan upload cap rumah sakit terlebih dahulu.");
            return;
        }

        alert("Form berhasil disubmit!");
        // Data gambar cap dapat diambil dari capPreview.src dan dikirim ke server
    });
</script>