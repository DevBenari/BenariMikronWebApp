@model LoginViewModel

@{
    ViewBag.Title = "Login";
}

<div class="sign-in-from">
    <img src="~/xray/images/login/logo_mmc.png" alt="Alternate Text" width="100%" style="margin-top: 100px; margin-bottom: 30px;" />
    @* <h3 class="mb-0" style="margin-top: 30px;">Welcome Back,</h3>
    <h3 style="margin-top: -7px;">Sign In for Get Started</h3> *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <div class="iq-alert-text"><b>Maaf!</b> - @TempData["Error"]</div>
        </div>
    }
    <form class="mt-4" method="post">
        <div class="form-group">
            <label for="exampleInputEmail1" class="mb-2">Email address</label>
            <input type="email" asp-for="Email" autocomplete="off" id="email" class="form-control" placeholder="Email" maxlength="45" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-between my-2">
            <label for="exampleInputPassword1">Password</label>
            <a href="#" onclick="forgot()" id="forgotPassword">Lupa kata sandi?</a>
        </div>
        <div class="password-field">
            <input type="password" asp-for="Password" id="showPassword" class="form-control" placeholder="Kata Sandi" maxlength="45" />
            @* <span></span> *@
            <span asp-validation-for="Password"></span><i class="ri-eye-close-line" id="toggler"></i>
        </div>
        
        @* <div class="d-flex form-check form-check-reverse">
            <label>
                <input type="checkbox" id="showPassword">
                Tampilkan kata sandi
            </label>
        </div> *@
        <div class="d-flex w-100 justify-content-between align-items-center mt-3 w-100">
            <div class="custom-control custom-checkbox d-inline-block mt-2 pt-1">
                <label asp-for="RememberMe">
                    <input asp-for="RememberMe">
                    @Html.DisplayNameFor(m => m.RememberMe)
                </label>
            </div>
            <button type="submit" class="btn float-end" style="background-color: #083840; color: white;">Sign in</button>
        </div>
        
    </form>
    @* <form method="post">
        <div class="form-outline mb-4">
            <input type="email" asp-for="Email" autocomplete="off" id="email" class="form-control" placeholder="Email" maxlength="45" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-outline mb-2">
            <input type="password" asp-for="Password" id="password" class="form-control" placeholder="Kata Sandi" maxlength="45" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-check form-check-inline">
                <label>
                    <input type="checkbox" id="showPassword">
                    Tampilkan kata sandi
                </label>
            </div>
        </div>
        <button type="submit" class="form-control btn btn-primary rounded submit px-3">Masuk</button>
    </form>
    <div class="form-check form-check-inline">
        <label asp-for="RememberMe">
            <input asp-for="RememberMe">
            @Html.DisplayNameFor(m => m.RememberMe)
        </label>
    </div>
    <div class="text-center pt-1 mb-1 pb-1">
        <a href="#" onclick="forgot()" id="forgotPassword">Lupa kata sandi?</a>
    </div> *@
</div>

@section Scripts {
    <style>
        .password-field {
          position: relative;
        }

        .password-field #toggler {
          position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
        }
    </style>
    @* <script>
        $(function () {
            //Initialize Select2 Elements
            $('.select2bs4').select2({
                theme: 'bootstrap4'
            })
        })
    </script> *@
    <script type="text/javascript">
        var password = document.getElementById('showPassword');
        var toggler = document.getElementById('toggler');
        showHidePassword = () => {
        if (password.type == 'password') {
        password.setAttribute('type', 'text');
        toggler.classList.add('ri-eye-line');
        } else {
        toggler.classList.remove('ri-eye-line');
        password.setAttribute('type', 'password');
        }
        };
        toggler.addEventListener('click', showHidePassword);
        // var show = document.getElementById('showPassword');
        // var textbox = document.getElementById('password');

        // show.addEventListener("click", function () {
        //     var isCheked = show.checked;
        //     console.log(isCheked);
        //     if (isCheked) {
        //         textbox.type = "text";
        //     } else {
        //         textbox.type = "password";
        //     }
        // })
    </script>
    <script type="text/javascript">
        function forgot() {
            Swal.fire(
                'Lupa Kata Sandi?',
                'Hubungi bagian Admin/IT BenariLinkMed di Email : admin@benarisolusindo.com',
                'question'
            )
        };
    </script>
}